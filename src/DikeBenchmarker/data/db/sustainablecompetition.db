CREATE TABLE performances (
    "status" TEXT,
    "perf" INTEGER,
    "inst_hash" TEXT,
    "env_id" TEXT,
    "res_id" INTEGER,
    "solver_id" TEXT,
    PRIMARY KEY ("inst_hash", "env_id", "res_id", "solver_id"),
    FOREIGN KEY ("inst_hash") REFERENCES instances("inst_hash"),
    FOREIGN KEY ("env_id") REFERENCES environments("env_id"),
    FOREIGN KEY ("res_id") REFERENCES resources("res_id"),
    FOREIGN KEY ("solver_id") REFERENCES solvers("solver_id")
);
